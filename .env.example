# Banco de dados PostgreSQL (ex: Neon, Supabase, Railway, RDS)
DATABASE_URL="postgresql://usuario:senha@host:5432/spitz_platform?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Opcional: extração automática dos laudos genéticos por IA (Fase 2).
# Sem essa chave, o cadastro de laudo continua funcionando normalmente,
# só que 100% manual (sem o botão "Extrair com IA").
ANTHROPIC_API_KEY=""

# Opcional: pagamentos (Fase 9) — assinatura PRO, destaque Premium de
# anúncios e comissão de venda. Sem essas chaves, os botões de pagamento
# mostram um erro claro em vez de tentar cobrar; o admin ainda pode
# ativar PRO manualmente em /admin para testar sem pagamento real.
# Pegue o Access Token em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=""
# Configurado em "Suas integrações" > Webhooks, no painel do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=""

# Opcional em desenvolvimento, OBRIGATÓRIO em produção (ex: Vercel):
# armazenamento de fotos e documentos em Cloudflare R2 (compatível com S3).
# Sem essas 4 variáveis preenchidas, o sistema salva em disco local
# (public/uploads) — funciona local, mas NÃO funciona em serverless.
# Crie o bucket em https://dash.cloudflare.com > R2, gere um token de API
# com permissão de leitura/escrita, e habilite acesso público (r2.dev ou
# domínio customizado) para preencher R2_PUBLIC_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
