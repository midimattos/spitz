// Fase 0 — Fundação
// Este schema cobre: autenticação multi-perfil (NextAuth) e a estrutura
// mínima de Usuário/Canil que as próximas fases vão expandir.
// Novos modelos (Cao, Ninhada, DossieGenetico, Anuncio, etc.) entram
// nas fases seguintes, sem quebrar o que já existe aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Autenticação (NextAuth / Auth.js) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Papéis do sistema ----------

enum Role {
  ADMIN     // Equipe da plataforma
  CRIADOR   // Assinante do SaaS, dono de um ou mais canis
  COMPRADOR // Usuário do marketplace público
}

// ---------- Usuário ----------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null quando o login é só via provedor OAuth
  image         String?
  role          Role      @default(COMPRADOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Um usuário CRIADOR pode ser dono de um canil.
  canil Canil?

  // Um usuário COMPRADOR pode ter um desejo ativo no Radar de Demanda.
  desejoComprador DesejoComprador?

  favoritos          Favorito[]
  notificacoes       Notificacao[]
  desejosHistorico   DesejoHistorico[]

  @@index([role])
}

// ---------- Canil (stub — expandido na Fase 1) ----------

model Canil {
  id          String   @id @default(cuid())
  nome        String
  slug        String   @unique
  cidade      String?
  estado      String?
  descricao   String?
  verificado  Boolean  @default(false) // selo de canil aprovado (fase invite-only)
  assinaturaPro Boolean @default(false) // camada PRO (Fase 8) — ativado manualmente pelo admin até a Fase 9 (cobrança) existir
  telefoneContato String?
  instagram   String?
  avisoSemanal Boolean @default(true) // resumo semanal de saúde da carteira por e-mail
  solicitacaoVerificacaoEm DateTime? // quando o criador pediu revisão (fila de aprovação)
  criadoEm    DateTime @default(now())

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  caes Cao[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  faixasPreco FaixaPrecoBase[]
  anuncios Anuncio[]
  avaliacoes Avaliacao[]
  pagamentos Pagamento[]
  criopreservacoes Criopreservacao[]
  vendasRegistradas VendaRegistro[]
  convitesCriados Convite[] @relation("ConvitesCriados")
  conviteUsado    Convite?  @relation("ConviteUsado")

  @@index([verificado])
}

// ---------- Fase 1: Plantel (cães do canil) ----------

enum Sexo {
  MACHO
  FEMEA
}

enum PapelCao {
  MATRIZ     // fêmea reprodutora ativa
  PADREADOR  // macho reprodutor ativo
  FILHOTE    // ainda não definiu papel reprodutivo
  APOSENTADO // não reproduz mais, mas fica no histórico
}

enum TipoDocumento {
  PEDIGREE
  RECIBO_VETERINARIO
  MICROCHIP
  CONTRATO_COPROPRIEDADE
  LAUDO_MEDICO
  LAUDO_GENETICO
  OUTRO
}

model Cao {
  id              String    @id @default(cuid())
  nome            String
  sexo            Sexo
  papel           PapelCao  @default(FILHOTE)
  fotoUrl         String?
  corPelagem      String? // descrição livre (compatibilidade com cadastros antigos)
  porte           String? // ex: Anão, Pequeno, Médio
  microchip       String?
  dataNascimento  DateTime?
  dataFalecimento DateTime?
  observacoes     String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  // ---- Fenótipo estruturado (cor), usado pelo motor de genética de cor ----
  corBase             String? // Preto, Chocolate, Lilás, Beaver, Laranja/Sable, Wolf Sable, Creme/Branco, Azul/Cinza, Merle, Tricolor
  marcacaoCor         String? // Sólido, Sable, Wolf Sable, Tan Points, Tricolor, Particolor, Merle, Branco Extremo, Máscara
  corTrufa            String? // Preta, Marrom, Lilás, Azul/Acinzentada, Carne
  diluicaoCor         String? // Densa, Diluída
  merleCor            String? // Não Merle, Merle, Harlequin
  intensidadeCor      String? // Alta (Vívida), Média, Baixa (Pálida)
  coresJaProduzidas   String[] // cores observadas em filhotes deste cão — evidência p/ inferência de portador oculto

  // ---- Genótipo de cor confirmado por exame de DNA (opcional) ----
  // Preenchido manualmente pelo criador a partir de um painel de cor (ex:
  // Embark). Quando presente, o motor de genética usa isso em vez de
  // inferir do fenótipo. Formato "X/x", ex: "B/b".
  temExameCorDNA Boolean @default(false)
  dnaLocusB      String?
  dnaLocusE      String?
  dnaLocusK      String?
  dnaLocusA      String?
  dnaLocusD      String?
  dnaLocusS      String?
  dnaLocusM      String?
  dnaLocusI      String?

  canilId String
  canil   Canil  @relation(fields: [canilId], references: [id], onDelete: Cascade)

  // Árvore genealógica: um cão pode referenciar pai e mãe já cadastrados
  // no sistema (do mesmo canil ou de outro, para permitir linhagens externas).
  paiId         String?
  pai           Cao?  @relation("Paternidade", fields: [paiId], references: [id])
  filhosComoPai Cao[] @relation("Paternidade")

  maeId         String?
  mae           Cao?  @relation("Maternidade", fields: [maeId], references: [id])
  filhosComoMae Cao[] @relation("Maternidade")

  documentos Documento[]
  laudosGeneticos LaudoGenetico[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  ciclosCio CicloCio[]
  ninhadasComoMae Ninhada[] @relation("NinhadaMae")
  ninhadasComoPai Ninhada[] @relation("NinhadaPai")
  dossieGenetico DossieGenetico?
  anuncios Anuncio[]
  cuidados RegistroCuidado[]
  criopreservacoes Criopreservacao[]

  @@index([canilId])
  @@index([papel])
}

// "Gaveta Digital": documentos anexados à ficha do cão.
model Documento {
  id       String        @id @default(cuid())
  caoId    String
  cao      Cao           @relation(fields: [caoId], references: [id], onDelete: Cascade)
  tipo     TipoDocumento
  nome     String
  url      String
  criadoEm DateTime      @default(now())

  laudoGenetico LaudoGenetico?

  @@index([caoId])
}

// ---------- Fase 2: Inteligência Genética e Saúde ----------

enum StatusGenetico {
  LIVRE     // não carrega o gene (clear)
  PORTADOR  // carrega uma cópia do gene, mas não é afetado (carrier)
  AFETADO   // carrega duas cópias / manifesta a condição (affected)
}

// Um laudo de laboratório (ex: Embark, Wisdom Panel, laboratório local),
// anexado como Documento e com um ou mais resultados padronizados.
model LaudoGenetico {
  id          String    @id @default(cuid())
  caoId       String
  cao         Cao       @relation(fields: [caoId], references: [id], onDelete: Cascade)
  laboratorio String
  dataLaudo   DateTime?
  criadoEm    DateTime  @default(now())

  documentoId String?    @unique
  documento   Documento? @relation(fields: [documentoId], references: [id])

  resultados ResultadoGenetico[]

  @@index([caoId])
}

// Cada condição testada dentro de um laudo (ex: "PRA" -> LIVRE).
// O nome da condição é livre (texto), para acomodar laudos de labs
// diferentes sem depender de uma tabela fechada de doenças.
model ResultadoGenetico {
  id         String         @id @default(cuid())
  laudoId    String
  laudo      LaudoGenetico  @relation(fields: [laudoId], references: [id], onDelete: Cascade)
  condicao   String
  status     StatusGenetico
  observacao String?

  @@index([laudoId])
  @@index([condicao])
}

// ---------- Fase 3: Ciclo de Vida (financeiro e reprodutivo) ----------

enum TipoLancamento {
  RECEITA
  DESPESA
}

// Lançamento financeiro, opcionalmente vinculado a um cão específico
// (ex: veterinário do padreador X) ou geral do canil (ex: ração para todos).
model LancamentoFinanceiro {
  id        String         @id @default(cuid())
  canilId   String
  canil     Canil          @relation(fields: [canilId], references: [id], onDelete: Cascade)
  caoId     String?
  cao       Cao?           @relation(fields: [caoId], references: [id], onDelete: SetNull)
  tipo      TipoLancamento
  categoria String // ex: Ração, Veterinário, Venda de filhote, Taxa de registro
  valor     Decimal        @db.Decimal(10, 2)
  data      DateTime
  descricao String?
  criadoEm  DateTime       @default(now())

  // Custo atribuído a uma ninhada específica (opcional): alimenta o custo real por filhote.
  ninhadaId String?
  ninhada   Ninhada?       @relation(fields: [ninhadaId], references: [id], onDelete: SetNull)

  @@index([canilId])
  @@index([caoId])
  @@index([tipo])
  @@index([ninhadaId])
}

// Registro de início de cio de uma matriz, para prever o próximo ciclo.
model CicloCio {
  id          String   @id @default(cuid())
  caoId       String
  cao         Cao      @relation(fields: [caoId], references: [id], onDelete: Cascade)
  dataInicio  DateTime
  observacoes String?
  criadoEm    DateTime @default(now())

  @@index([caoId])
}

// Uma ninhada: da cobertura à previsão/registro do parto.
// O padreador pode ser um cão já cadastrado no sistema (caoPaiId) ou um
// nome livre, quando o macho pertence a outro canil (padreadorExterno).
model Ninhada {
  id                  String    @id @default(cuid())
  caoMaeId            String
  caoMae              Cao       @relation("NinhadaMae", fields: [caoMaeId], references: [id], onDelete: Cascade)
  caoPaiId            String?
  caoPai              Cao?      @relation("NinhadaPai", fields: [caoPaiId], references: [id])
  padreadorExterno    String?
  dataCobertura       DateTime
  dataPrevistaParto   DateTime // calculada: dataCobertura + 63 dias
  dataParto           DateTime?
  quantidadeFilhotes  Int?
  observacoes         String?
  criadoEm            DateTime  @default(now())

  lancamentos LancamentoFinanceiro[]

  @@index([caoMaeId])
}

// ---------- Fase 4: Dossiê Genético (Passaporte Digital) ----------

// Um dossiê por cão, com link público opcional. Os dados de saúde e
// genealogia são calculados a partir do restante do schema (LaudoGenetico,
// árvore de Cao); aqui só guardamos o COI calculado na última geração,
// o slug do link compartilhável e se ele está publicado.
model DossieGenetico {
  id           String   @id @default(cuid())
  caoId        String   @unique
  cao          Cao      @relation(fields: [caoId], references: [id], onDelete: Cascade)
  slugPublico  String   @unique
  publicado    Boolean  @default(false)
  coi          Float? // coeficiente de endogamia estimado, 0 a 1 (multiplicar por 100 para %)
  geradoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([slugPublico])
}

// ---------- Fase 5: Motor de Precificação Dinâmica ----------

// Faixa de preço de referência que o próprio criador configura por porte
// (ex: Anão, Pequeno, Médio). O motor de precificação usa essa faixa como
// base e ajusta o preço sugerido dentro dela conforme a qualidade genética
// de cada cão — ele não inventa um preço de mercado do zero.
model FaixaPrecoBase {
  id           String   @id @default(cuid())
  canilId      String
  canil        Canil    @relation(fields: [canilId], references: [id], onDelete: Cascade)
  porte        String
  precoMinimo  Decimal  @db.Decimal(10, 2)
  precoMedio   Decimal  @db.Decimal(10, 2)
  precoMaximo  Decimal  @db.Decimal(10, 2)
  atualizadoEm DateTime @updatedAt

  @@unique([canilId, porte])
}

// ---------- Fase 6: Marketplace público ----------

enum TipoAnuncio {
  GRATUITO
  PREMIUM // selo/destaque — cobrança ainda não implementada (ver Fase 9)
}

enum StatusAnuncio {
  RASCUNHO
  PUBLICADO
  PAUSADO
  VENDIDO
}

// Um anúncio de venda, criado a partir de um cão do plantel. Só aparece
// publicamente no marketplace se o canil for verificado E o anúncio
// estiver com status PUBLICADO — é o que implementa o modo "invite-only"
// da primeira fase do marketplace.
model Anuncio {
  id           String        @id @default(cuid())
  caoId        String
  cao          Cao           @relation(fields: [caoId], references: [id], onDelete: Cascade)
  canilId      String
  canil        Canil         @relation(fields: [canilId], references: [id], onDelete: Cascade)
  titulo       String
  descricao    String?
  preco        Decimal       @db.Decimal(10, 2)
  tipo         TipoAnuncio   @default(GRATUITO)
  status       StatusAnuncio @default(RASCUNHO)
  fotos        String[]
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  // Datas reais do ciclo de vida do anúncio — alimentam o "tempo até vender"
  // e a análise de encalhe do motor de mercado (antes usávamos atualizadoEm
  // como aproximação, o que distorcia o número).
  publicadoEm        DateTime?
  encerradoEm        DateTime?
  motivoEncerramento MotivoEncerramento?

  mensagens MensagemContato[]
  matches   Match[]
  pagamentos Pagamento[]
  historicoPrecos HistoricoPreco[]
  favoritos Favorito[]
  venda     VendaRegistro?

  @@index([canilId])
  @@index([status])
}

// Mensagem de um comprador interessado, enviada a partir da página
// pública do anúncio. Ainda não é um chat em tempo real (isso é a
// Fase 7 — Radar de Demanda / matchmaking); por ora é uma caixa de
// entrada simples para o criador.
model MensagemContato {
  id        String   @id @default(cuid())
  anuncioId String
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  nome      String
  email     String
  telefone  String?
  mensagem  String
  lida      Boolean  @default(false)
  respondidaEm DateTime? // quando o criador marcou como respondida (mede tempo de resposta)
  criadoEm  DateTime @default(now())

  denuncia DenunciaLead?

  @@index([anuncioId])
}

// Avaliação pública de um canil, deixada por um usuário COMPRADOR logado.
model Avaliacao {
  id          String   @id @default(cuid())
  canilId     String
  canil       Canil    @relation(fields: [canilId], references: [id], onDelete: Cascade)
  autorUserId String?
  autorNome   String
  nota        Int
  comentario  String?
  oculta      Boolean  @default(false) // moderação: avaliação escondida pelo admin (spam/fraude)
  criadoEm    DateTime @default(now())

  @@index([canilId])
}

// ---------- Fase 7: Radar de Demanda / Fila de Espera Reversa ----------

enum StatusOptIn {
  PENDENTE
  ACEITO
  RECUSADO
}

// O "desejo" de um comprador: o que ele está procurando. Um por
// comprador, para manter o radar simples nesta fase. O telefone é
// obrigatório como uma validação anti-fraude leve — não há verificação
// real de WhatsApp/SMS aqui (isso depende de um serviço pago tipo
// Twilio/Zenvia), só a exigência de informar um contato válido no
// formato antes de participar do radar.
model DesejoComprador {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  porte      String?
  sexo       Sexo?
  precoMax   Decimal? @db.Decimal(10, 2)
  corPelagem String?
  estado     String?
  // Características detalhadas do filhote desejado (mesmos campos da busca
  // do marketplace e do cadastro do cão). Todas opcionais.
  corBase  String?
  marcacao String?
  diluicao String?
  merle    String?
  precoMin Decimal? @db.Decimal(10, 2)
  cidade   String?
  telefone   String
  cpf        String? // valida só o formato (dígito verificador), não consulta a Receita Federal
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  // Validação anti-fraude do comprador (fila de aprovação do admin). O
  // contato do comprador só é liberado ao criador quando está APROVADO.
  validacao     StatusValidacao @default(PENDENTE)
  validadoEm    DateTime?
  validacaoNota String?

  matches Match[]
}

// Um cruzamento entre um desejo de comprador e um anúncio publicado.
// Segue o fluxo de "concierge" com double opt-in: o contato só é
// revelado para os dois lados quando AMBOS aceitam.
model Match {
  id              String      @id @default(cuid())
  desejoId        String
  desejo          DesejoComprador @relation(fields: [desejoId], references: [id], onDelete: Cascade)
  anuncioId       String
  anuncio         Anuncio     @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  statusComprador StatusOptIn @default(PENDENTE)
  statusCriador   StatusOptIn @default(PENDENTE)
  criadoEm        DateTime    @default(now())

  denuncia DenunciaLead?

  @@unique([desejoId, anuncioId])
  @@index([anuncioId])
}

// Denúncia de um lead suspeito/spam, feita pelo criador — vale tanto
// para uma mensagem de contato (Fase 6) quanto para um match do radar.
model DenunciaLead {
  id                String           @id @default(cuid())
  mensagemContatoId String?          @unique
  mensagemContato   MensagemContato? @relation(fields: [mensagemContatoId], references: [id], onDelete: Cascade)
  matchId           String?          @unique
  match             Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  motivo            String
  criadoEm          DateTime         @default(now())
}

// ---------- Fase 9: Transações, Comissões e Assinaturas ----------

enum TipoPagamento {
  ASSINATURA_PRO
  ANUNCIO_PREMIUM
  COMISSAO_VENDA
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

// Um cobrança processada via Mercado Pago (Checkout Pro). O status real
// só muda quando o webhook de pagamento confirma — nunca no clique do
// usuário, para não liberar nenhum benefício antes do pagamento cair.
model Pagamento {
  id                      String          @id @default(cuid())
  canilId                 String
  canil                   Canil           @relation(fields: [canilId], references: [id], onDelete: Cascade)
  anuncioId               String?
  anuncio                 Anuncio?        @relation(fields: [anuncioId], references: [id], onDelete: SetNull)
  tipo                    TipoPagamento
  valor                   Decimal         @db.Decimal(10, 2)
  status                  StatusPagamento @default(PENDENTE)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?         @unique
  criadoEm                DateTime        @default(now())
  atualizadoEm            DateTime        @updatedAt

  @@index([canilId])
  @@index([anuncioId])
  @@index([status])
}

// ---------- Fase 10: Growth e Operação ----------

// Convite gerado por um canil já verificado (ou pelo admin, quando
// criadoPorCanilId é nulo). Um canil que se cadastra usando um código
// válido já nasce verificado, pulando a fila de aprovação manual.
model Convite {
  id               String    @id @default(cuid())
  codigo           String    @unique
  criadoPorCanilId String?
  criadoPorCanil   Canil?    @relation("ConvitesCriados", fields: [criadoPorCanilId], references: [id], onDelete: SetNull)
  usadoPorCanilId  String?   @unique
  usadoPorCanil    Canil?    @relation("ConviteUsado", fields: [usadoPorCanilId], references: [id], onDelete: SetNull)
  criadoEm         DateTime  @default(now())
  usadoEm          DateTime?
}


// ---------- Fase 11: Camada de dados do marketplace ----------
//
// Tudo que alimenta o motor de precificação e a inteligência de mercado
// nasce aqui. Os eventos NÃO têm chave estrangeira para o anúncio de
// propósito: se um anúncio for apagado, o dado de mercado que ele gerou
// continua valendo para as estatísticas.

enum MotivoEncerramento {
  VENDIDO_PLATAFORMA // vendido para alguém que veio pela plataforma
  VENDIDO_FORA       // vendido por outro canal
  DESISTI            // criador desistiu de vender
  PRECO_ALTO         // retirado porque o preço não vendia
  OUTRO
}

enum CanalVenda {
  PLATAFORMA_MATCH   // veio pelo Radar / double opt-in
  PLATAFORMA_CONTATO // veio por mensagem de contato no anúncio
  FORA               // fechou por fora da plataforma
}

enum TipoEvento {
  VISUALIZACAO_ANUNCIO
  VISUALIZACAO_CANIL
  BUSCA
  FAVORITO
  CONTATO
  MATCH_INTERESSE
}

enum StatusValidacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum TipoCuidado {
  VACINA
  VERMIFUGO
  ANTIPULGAS
  CONSULTA
  OUTRO
}

enum TipoCriopreservacao {
  SEMEN
  EMBRIAO
  OVULO
}

enum StatusCriopreservacao {
  DISPONIVEL
  USADO
  DESCARTADO
}

enum TipoNotificacao {
  MENSAGEM_NOVA
  MATCH_NOVO
  MATCH_ACEITO
  COMPRADOR_APROVADO
  CANIL_VERIFICADO
  CIO_PROXIMO
  PARTO_PROXIMO
  CUIDADO_VENCENDO
  ANUNCIO_ENCALHADO
  SISTEMA
}

// Evento bruto de comportamento. `visitante` é um identificador anônimo
// gerado no navegador (sem dado pessoal) para não contar a mesma pessoa
// várias vezes. Os campos porte/cor/sexo/estado/preco são "fotografias"
// do que foi visto/buscado, para as agregações não dependerem de joins.
model EventoMercado {
  id        String     @id @default(cuid())
  tipo      TipoEvento
  anuncioId String?
  canilId   String?
  userId    String?
  visitante String?
  porte     String?
  cor       String?
  sexo      Sexo?
  estado    String?
  preco     Decimal?   @db.Decimal(10, 2)
  filtros   Json?
  origem    String? // de onde o visitante veio: instagram, whatsapp, google, facebook, direto, outro
  criadoEm  DateTime   @default(now())

  @@index([tipo, criadoEm])
  @@index([anuncioId, tipo])
  @@index([canilId])
}

model Favorito {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anuncioId String
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@unique([userId, anuncioId])
  @@index([anuncioId])
}

// Toda mudança de preço de um anúncio (inclusive o preço inicial).
model HistoricoPreco {
  id        String   @id @default(cuid())
  anuncioId String
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  preco     Decimal  @db.Decimal(10, 2)
  criadoEm  DateTime @default(now())

  @@index([anuncioId])
}

// Registro estruturado de uma venda. É a matéria-prima da precificação:
// guarda preço final REAL (não o pedido), canal e as características do
// cão no momento da venda, para comparáveis futuros.
model VendaRegistro {
  id             String     @id @default(cuid())
  anuncioId      String?    @unique
  anuncio        Anuncio?   @relation(fields: [anuncioId], references: [id], onDelete: SetNull)
  canilId        String
  canil          Canil      @relation(fields: [canilId], references: [id], onDelete: Cascade)
  precoAnunciado Decimal    @db.Decimal(10, 2)
  precoFinal     Decimal    @db.Decimal(10, 2)
  canal          CanalVenda
  dataVenda      DateTime
  diasAteVender  Int
  visualizacoes  Int        @default(0)
  contatos       Int        @default(0)
  porte          String?
  cor            String?
  sexo           Sexo?
  estado         String?
  temDossie      Boolean    @default(false)
  criadoEm       DateTime   @default(now())

  // Perfil de quem comprou (informado pelo criador ao registrar a venda; opcional).
  compradorNome   String?
  compradorEmail  String? // usado para avaliação verificada, certificado e pós-venda
  origemComprador String? // MARKETPLACE | INSTAGRAM | INDICACAO | WHATSAPP | OUTRO
  estadoComprador String?
  cidadeComprador String?

  @@index([dataVenda])
  @@index([porte, cor])
  @@index([canilId])
}

// Histórico de desejos: um desejo novo NÃO apaga o anterior, vira linha
// aqui. Dá a série temporal da demanda por cor/porte/faixa de preço.
model DesejoHistorico {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  porte      String?
  sexo       Sexo?
  precoMax   Decimal? @db.Decimal(10, 2)
  cor        String?
  estado     String?
  corBase    String?
  marcacao   String?
  diluicao   String?
  merle      String?
  precoMin   Decimal? @db.Decimal(10, 2)
  cidade     String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([cor, porte])
}

// ---------- Fase 12: Rotina do canil (cuidados, criopreservação, avisos) ----------

model RegistroCuidado {
  id          String      @id @default(cuid())
  caoId       String
  cao         Cao         @relation(fields: [caoId], references: [id], onDelete: Cascade)
  tipo        TipoCuidado
  nome        String
  data        DateTime
  proximaData DateTime?
  observacoes String?
  criadoEm    DateTime    @default(now())

  @@index([caoId])
  @@index([proximaData])
}

model Criopreservacao {
  id          String                @id @default(cuid())
  canilId     String
  canil       Canil                 @relation(fields: [canilId], references: [id], onDelete: Cascade)
  caoId       String?
  cao         Cao?                  @relation(fields: [caoId], references: [id], onDelete: SetNull)
  tipo        TipoCriopreservacao
  doses       Int
  dataColeta  DateTime
  local       String? // ex: clínica / tanque / botijão
  validade    DateTime?
  status      StatusCriopreservacao @default(DISPONIVEL)
  observacoes String?
  criadoEm    DateTime              @default(now())

  @@index([canilId])
  @@index([caoId])
}

// Aviso interno (sino). `chave` evita duplicar o mesmo aviso automático
// (ex.: "cio da Bella em 2026-11-05") a cada vez que a rotina roda.
model Notificacao {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     TipoNotificacao
  titulo   String
  mensagem String
  link     String?
  lida     Boolean         @default(false)
  chave    String?
  criadoEm DateTime        @default(now())

  @@unique([userId, chave])
  @@index([userId, lida])
}
